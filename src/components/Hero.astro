---
import { Image } from "astro:assets";

// ヒーロー＝釣果のベストショット＋海の風景（人物なしの夕日）を自動切替で表示。
// 魚写真はギャラリーと共有（同一ファイルを指定）。差し替えたい場合はこの配列を編集。
import sunset from "../assets/hero/gallery-026.jpg";
import madai1 from "../assets/gallery/gallery-017.jpg";
import hiramasa from "../assets/gallery/gallery-091.jpg";
import madai2 from "../assets/gallery/gallery-028.jpg";
import buri1 from "../assets/gallery/gallery-050.jpg";
import kue from "../assets/gallery/gallery-070.jpg";
import buri2 from "../assets/gallery/gallery-037.jpg";
import amadai from "../assets/gallery/gallery-018.jpg";

const picked = [madai1, hiramasa, sunset, madai2, buri1, kue, buri2, amadai];
---

<section id="hero" class="hero">
  <div class="hero__slideshow" aria-hidden="true">
    {
      picked.map((img, i) => (
        <div class:list={["hero__slide", { "is-active": i === 0 }]}>
          <Image
            src={img}
            alt=""
            widths={[768, 1280, 1920]}
            sizes="100vw"
            quality={72}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
          />
        </div>
      ))
    }
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__content">
    <p class="hero__eyebrow">SLJ / LJ 山陰遊漁船</p>
    <h1 class="hero__title">遊漁船ファミリア</h1>
    <p class="hero__sub">島根県松江市・鹿島マリーナ発着</p>
    <div class="hero__actions">
      <a class="hero__cta" href="#schedule">出船スケジュールを見る</a>
      <a
        class="hero__cta hero__cta--line"
        href="https://lin.ee/fipwyGn"
        target="_blank"
        rel="noopener noreferrer">LINEで予約</a
      >
    </div>
  </div>

  <a class="hero__scroll" href="#greeting" aria-label="下にスクロール">
    <span></span>
  </a>
</section>

<script>
  // ヒーロースライドショー（クロスフェード＋Ken Burns）
  const slides = document.querySelectorAll<HTMLElement>(".hero__slide");
  if (slides.length > 1) {
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (!prefersReduced) {
      let idx = 0;
      setInterval(() => {
        slides[idx].classList.remove("is-active");
        idx = (idx + 1) % slides.length;
        slides[idx].classList.add("is-active");
      }, 6000);
    }
  }
</script>
