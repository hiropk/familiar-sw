---

<div class="logo">
  <img src="/images/famipaka.jpg" id="icon" alt="遊漁船ファミリア" />
  <h1>
    島根県1352<br />
    遊漁船ファミリア
  </h1>
  <p>　　　　</p>
  <a
    href="https://www.instagram.com/familiar_matsue/"
    target="_blank"
    rel="noopener noreferrer"
  >
    <i
      class="fa-brands fa-instagram fa-2x insta"
      style="color: rgb(236, 13, 61)"
    ></i>
  </a>
  <p>&nbsp;</p>
  <a href="https://lin.ee/fipwyGn" target="_blank" rel="noopener noreferrer">
    <i class="fa-brands fa-line fa-2x line" style="color: green"></i>
  </a>
</div>

<button
  class="hamburger"
  aria-label="メニュー"
  aria-controls="nav-menu"
  aria-expanded="false"
>
  <span class="hamburger__line"></span>
  <span class="hamburger__line"></span>
  <span class="hamburger__line"></span>
</button>

<nav id="nav-menu" class="nav" aria-hidden="true">
  <ul class="nav__list">
    <li class="nav__item"><a href="#top" class="nav__link">トップ</a></li>
    <li class="nav__item">
      <a href="#schedule" class="nav__link">出船スケジュール</a>
    </li>
    <li class="nav__item">
      <a href="#pricing" class="nav__link">乗船料金</a>
    </li>
    <li class="nav__item">
      <a href="#boat" class="nav__link">船の紹介</a>
    </li>
    <li class="nav__item">
      <a href="#captain" class="nav__link">船長の紹介</a>
    </li>
    <li class="nav__item">
      <a href="#boarding" class="nav__link">乗船案内</a>
    </li>
    <li class="nav__item">
      <a href="#register" class="nav__link">乗船名簿</a>
    </li>
    <li class="nav__item">
      <a href="#safety" class="nav__link">安全情報</a>
    </li>
    <li class="nav__item">
      <a href="#weather" class="nav__link">天気</a>
    </li>
    <li class="nav__item">
      <a href="#links" class="nav__link">リンク</a>
    </li>
  </ul>
</nav>

<script>
  // ハンバーガーメニューの開閉
  const hamburger = document.querySelector(".hamburger");
  const nav = document.querySelector(".nav");

  if (hamburger && nav) {
    const closeMenu = () => {
      hamburger.classList.remove("active");
      nav.classList.remove("active");
      hamburger.setAttribute("aria-expanded", "false");
      nav.setAttribute("aria-hidden", "true");
    };

    hamburger.addEventListener("click", () => {
      const willOpen = !hamburger.classList.contains("active");
      hamburger.classList.toggle("active", willOpen);
      nav.classList.toggle("active", willOpen);
      hamburger.setAttribute("aria-expanded", String(willOpen));
      nav.setAttribute("aria-hidden", String(!willOpen));
    });

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (
        !target.closest(".nav") &&
        !target.closest(".hamburger") &&
        nav.classList.contains("active")
      ) {
        closeMenu();
      }
    });

    nav.querySelector(".nav__list")?.addEventListener("click", () => {
      if (nav.classList.contains("active")) closeMenu();
    });
  }
</script>
