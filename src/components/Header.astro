---
// サイト共通ヘッダー（ロゴ・ナビ・SNS・ハンバーガー）
const navItems = [
  { href: "/", label: "トップ" },
  { href: "/#schedule", label: "出船スケジュール" },
  { href: "/#pricing", label: "乗船料金" },
  { href: "/#boat", label: "船の紹介" },
  { href: "/#captain", label: "船長の紹介" },
  { href: "/#boarding", label: "乗船案内" },
  { href: "/#register", label: "乗船名簿" },
  { href: "/#safety", label: "安全情報" },
  { href: "/gallery", label: "ギャラリー" },
  { href: "/#weather", label: "天気" },
  { href: "/#links", label: "リンク" },
];
---

<div class="header__inner">
  <a class="brand" href="/" aria-label="遊漁船ファミリア トップへ">
    <img
      class="brand__icon"
      id="icon"
      src="/images/famipaka.jpg"
      width="48"
      height="48"
      alt="遊漁船ファミリア"
    />
    <span class="brand__text">
      <span class="brand__pref">島根県1352</span>
      <span class="brand__name">遊漁船ファミリア</span>
    </span>
  </a>

  <nav id="nav-menu" class="nav" aria-label="メインメニュー" aria-hidden="true">
    <ul class="nav__list">
      {
        navItems.map((item) => (
          <li class="nav__item">
            <a href={item.href} class="nav__link">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="header__actions">
    <a
      class="social social--insta"
      href="https://www.instagram.com/familiar_matsue/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
    >
      <i class="fa-brands fa-instagram"></i>
    </a>
    <a
      class="social social--line"
      href="https://lin.ee/fipwyGn"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LINE"
    >
      <i class="fa-brands fa-line"></i>
    </a>
    <button
      class="hamburger"
      aria-label="メニューを開く"
      aria-controls="nav-menu"
      aria-expanded="false"
    >
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
    </button>
  </div>

  <div class="nav__backdrop" hidden></div>
</div>

<script>
  // ハンバーガーメニューの開閉（モバイル）
  const hamburger = document.querySelector<HTMLButtonElement>(".hamburger");
  const nav = document.querySelector<HTMLElement>(".nav");
  const backdrop = document.querySelector<HTMLElement>(".nav__backdrop");

  if (hamburger && nav) {
    const closeMenu = () => {
      hamburger.classList.remove("active");
      nav.classList.remove("active");
      hamburger.setAttribute("aria-expanded", "false");
      hamburger.setAttribute("aria-label", "メニューを開く");
      nav.setAttribute("aria-hidden", "true");
      if (backdrop) backdrop.hidden = true;
      document.body.classList.remove("nav-open");
    };

    const openMenu = () => {
      hamburger.classList.add("active");
      nav.classList.add("active");
      hamburger.setAttribute("aria-expanded", "true");
      hamburger.setAttribute("aria-label", "メニューを閉じる");
      nav.setAttribute("aria-hidden", "false");
      if (backdrop) backdrop.hidden = false;
      document.body.classList.add("nav-open");
    };

    hamburger.addEventListener("click", () => {
      if (hamburger.classList.contains("active")) closeMenu();
      else openMenu();
    });

    backdrop?.addEventListener("click", closeMenu);

    nav.querySelectorAll(".nav__link").forEach((link) => {
      link.addEventListener("click", () => {
        if (nav.classList.contains("active")) closeMenu();
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("active")) closeMenu();
    });
  }
</script>
