---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/family/*.{jpg,jpeg,JPG,JPEG,png,PNG}",
  { eager: true }
);
const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);
---

<section class="page-hero" aria-label="家族の写真">
  <div class="page-hero__slideshow" aria-hidden="true">
    {
      photos.map((img, i) => (
        <div class:list={["page-hero__slide", { "is-active": i === 0 }]}>
          <Image
            src={img}
            alt=""
            widths={[768, 1280, 1920]}
            sizes="100vw"
            quality={72}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
          />
        </div>
      ))
    }
    <div class="page-hero__scrim"></div>
  </div>

  <div class="page-hero__message">
    <img
      class="page-hero__icon"
      src="/images/my_icon.jpg"
      width="132"
      height="132"
      alt="加納寛之"
    />
    <h2 class="page-hero__label">メッセージ</h2>
    <p>
      幼い頃から釣りを始め、大学生の時にオフショアフィッシングに出会いました。以降、オフショアフィッシングに没頭。学校の先生として働くなかで、もう一度釣りと向き合いたいと思い退職。未熟な若造ですが、みなさんとの素敵な思い出づくりのために全力でサポートします。
    </p>
    <p class="page-hero__sign">加納寛之</p>
  </div>
</section>

<script>
  const root = document.querySelector(".page-hero");
  const slides = root?.querySelectorAll<HTMLElement>(".page-hero__slide");
  if (slides && slides.length > 1) {
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (!prefersReduced) {
      let idx = 0;
      setInterval(() => {
        slides[idx].classList.remove("is-active");
        idx = (idx + 1) % slides.length;
        slides[idx].classList.add("is-active");
      }, 6000);
    }
  }
</script>
