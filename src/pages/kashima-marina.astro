---
import Base from "../layouts/Base.astro";

// NOTE: 本文は集客(SEO)用の新規ドラフトです。住所・乗船手順・料金・注意事項は既存サイトから流用しています。
const title =
  "鹿島マリーナ発着の遊漁船｜山陰遊漁船ファミリア（島根県松江市）";
const description =
  "島根県松江市の鹿島マリーナから出船する遊漁船ファミリアのアクセス・乗船案内・料金のご案内。駐車場や乗船手順、ご予約方法もこちら。";

const mapQuery = encodeURIComponent(
  "島根県松江市鹿島町佐陀本郷1371-1 鹿島マリーナ"
);
---

<Base title={title} description={description}>
  <article class="lp">
    <header class="lp__hero">
      <p class="lp__eyebrow">島根県松江市</p>
      <h1>鹿島マリーナ発着のご案内</h1>
      <p class="lp__lead">
        山陰遊漁船ファミリアは、島根県松江市の鹿島マリーナから出船します。アクセス・駐車場・乗船手順をまとめました。はじめての方も安心してお越しください。
      </p>
      <div class="lp__cta-row">
        <a class="btn btn--line" href="https://lin.ee/fipwyGn" target="_blank" rel="noopener noreferrer">LINEで予約する</a>
        <a class="btn btn--ghost" href="/#schedule">出船スケジュールを見る</a>
      </div>
    </header>

    <section class="lp__block" data-reveal>
      <h2>出船場所・アクセス</h2>
      <p class="lp__address">
        島根県松江市鹿島町佐陀本郷１３７１−１<br />鹿島マリーナ
      </p>
      <div class="lp__map">
        <iframe
          title="鹿島マリーナの地図"
          src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </section>

    <section class="lp__block" data-reveal>
      <h2>乗船手順</h2>
      <ol class="lp__steps">
        <li>マリーナ内の①②にお車を止めてください</li>
        <li>赤で示す桟橋に荷物を下ろし、お車を③④⑤にご移動ください</li>
        <li>トイレを済ませて桟橋でお待ちください</li>
        <li>乗船名簿へ必要事項をご入力ください</li>
        <li>集合時間を目安に桟橋に船を付けます</li>
        <li>釣り座を決めて荷物を積み込み出船します</li>
      </ol>
      <div class="lp__cta-row">
        <a
          class="btn btn--ghost"
          href="https://tsurimaru.jp/onlinepassengerlist/?fbid=LlmcJKotiwUjyuQJ4eHP7ZxkF6J3&openExternalBrowser=1"
          target="_blank"
          rel="noopener noreferrer">乗船名簿はこちら</a
        >
      </div>
    </section>

    <section class="lp__block" data-reveal>
      <h2>ご利用料金</h2>
      <table class="lp__table">
        <thead>
          <tr><th>プラン</th><th>料金</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>乗合（ジギング・タイラバ・ボートロック・餌）<br /><small>※遠征は追加料金あり</small></td>
            <td>¥13,000 / 1人</td>
          </tr>
          <tr>
            <td>乗合（イカ・アジ）</td>
            <td>¥11,000 / 1人</td>
          </tr>
          <tr>
            <td>チャーター（ジギング・タイラバ）<br /><small>※7名の場合 +¥11,000</small></td>
            <td>¥66,000</td>
          </tr>
          <tr>
            <td>チャーター（ボートロック・餌）</td>
            <td>¥44,000</td>
          </tr>
          <tr>
            <td>チャーター（白イカ・アジ）<br /><small>※7名の場合 +¥10,000</small></td>
            <td>¥60,000</td>
          </tr>
        </tbody>
      </table>
      <p class="lp__note">※お支払は現金のみ。その他メニューもご相談により受け付けます。</p>
    </section>

    <section class="lp__block" data-reveal>
      <h2>ご利用時の注意</h2>
      <ul class="lp__notes">
        <li><strong>黄色で示す駐車場はマリーナ契約者専用ですのでご利用はお控えください。</strong></li>
        <li>イカ釣りを除き原則共用クーラーを使用します。飲食用のクーラーを除き、お客様ご自身のクーラーの積み込みはご遠慮ください。</li>
        <li>共用クーラーの氷はこちらで用意します。お客様への氷も少量ご用意させていただきますが、量に限りがあるためご不安の場合は各自でのご用意をお願いします。</li>
      </ul>
      <div class="lp__cta-row">
        <a class="btn btn--line" href="https://lin.ee/fipwyGn" target="_blank" rel="noopener noreferrer">LINEで予約する</a>
        <a class="btn btn--ghost" href="/gallery">釣果ギャラリーを見る</a>
      </div>
    </section>
  </article>
</Base>

<style>
  .lp {
    max-width: 820px;
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 4rem) clamp(1.1rem, 4vw, 2rem) 4rem;
  }
  .lp__hero {
    text-align: center;
    padding: 1rem 0 2.4rem;
  }
  .lp__eyebrow {
    letter-spacing: 0.2em;
    color: var(--teal);
    font-weight: 600;
    font-size: 0.85rem;
  }
  .lp__hero h1 {
    font-size: clamp(1.9rem, 7vw, 3rem);
    letter-spacing: 0.06em;
    margin: 0.4rem 0 1rem;
  }
  .lp__lead {
    color: var(--ink-soft);
    line-height: 2;
    max-width: 680px;
    margin-inline: auto;
  }
  .lp__block {
    margin-top: 3rem;
  }
  .lp__block h2 {
    font-family: var(--font-head);
    font-size: clamp(1.4rem, 5vw, 1.9rem);
    color: var(--navy-900);
    padding-bottom: 0.7rem;
    margin-bottom: 1.2rem;
    border-bottom: 2px solid var(--sand-line);
  }
  .lp__address {
    font-size: 1.1rem;
    line-height: 1.9;
    font-family: var(--font-head);
    color: var(--navy);
    margin-bottom: 1.2rem;
  }
  .lp__map {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .lp__map iframe {
    display: block;
    width: 100%;
    height: 420px;
    border: none;
  }
  .lp__steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .lp__steps li {
    counter-increment: step;
    position: relative;
    padding: 0.9rem 1rem 0.9rem 3.2rem;
    background: var(--cream-50);
    border: 1px solid var(--sand-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    line-height: 1.8;
  }
  .lp__steps li::before {
    content: counter(step);
    position: absolute;
    left: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 700;
    border-radius: 50%;
  }
  .lp__notes {
    padding-left: 1.1rem;
    line-height: 1.9;
  }
  .lp__notes li {
    margin: 0.6rem 0;
  }
  .lp__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--cream-50);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    margin-bottom: 1rem;
  }
  .lp__table th {
    background: var(--navy);
    color: #fff;
    font-family: var(--font-head);
    padding: 0.9rem;
    letter-spacing: 0.06em;
  }
  .lp__table td {
    padding: 1rem;
    border-bottom: 1px solid var(--sand-line);
    text-align: center;
  }
  .lp__table tbody tr:last-child td {
    border-bottom: none;
  }
  .lp__table td:last-child {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy);
    white-space: nowrap;
  }
  .lp__note {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .lp__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
    margin-top: 1.6rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.8rem;
    border-radius: var(--radius-pill);
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.04em;
    box-shadow: var(--shadow);
    transition: transform 0.25s var(--ease), background 0.25s var(--ease);
  }
  .btn:hover {
    transform: translateY(-3px);
  }
  .btn--line {
    background: #06c755;
    color: #fff;
  }
  .btn--line:hover {
    background: #05a648;
  }
  .btn--ghost {
    background: var(--cream-50);
    color: var(--navy);
    border: 1px solid var(--sand-line);
    box-shadow: var(--shadow-sm);
  }
</style>
