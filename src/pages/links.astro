---
import Base from "../layouts/Base.astro";

const title = "リンク | 山陰遊漁船ファミリア（松江・鹿島マリーナ）";
const description =
  "山陰遊漁船ファミリアの関連リンク。FIELD's、海峡、るり丸、お花坊の釣り日誌をご紹介します。";
---

<Base title={title} description={description}>
  <section id="links" class="page">
    <h1 class="visually-hidden">リンク</h1>
    <ul>
      <li>
        <a
          href="https://tottori.tsurisoku.com/fields/"
          target="_blank"
          rel="noopener noreferrer">FIELD's~playing nature~</a
        >
      </li>
      <li>
        <a href="https://kaikyo.cc" target="_blank" rel="noopener noreferrer">海 峡</a>
      </li>
      <li>
        <a href="https://rurimaru.com" target="_blank" rel="noopener noreferrer">る り 丸</a>
      </li>
      <li>
        <a
          href="https://www.youtube.com/@ohanabou"
          target="_blank"
          rel="noopener noreferrer">お 花 坊 の 釣 り 日 誌</a
        >
      </li>
    </ul>
  </section>
</Base>
